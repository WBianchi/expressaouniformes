DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
AUTH_SECRET=

# Apply db/002_ai_generation_limits.sql before enabling paid generation.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
AI_IMAGE_GENERATION_ENABLED=false

# Pagamentos (Asaas). Sem ASAAS_API_KEY o checkout funciona em modo demonstração (sem cobrança).
# Chaves de sandbox começam com $aact_hmlg_ e de produção com $aact_prod_ — use a chave do mesmo ambiente.
# No .env, escape o cifrão: ASAAS_API_KEY=\$aact_prod_...
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Token (32–255 caracteres, sem espaços) cadastrado no webhook do painel Asaas; chega no header asaas-access-token.
# Aplique db/003_shop_orders.sql para persistir pedidos e eventos de webhook quando DATABASE_URL existir.
ASAAS_WEBHOOK_TOKEN=

# Frete (Frenet). Sem FRENET_TOKEN o site usa uma estimativa local (só para desenvolvimento).
FRENET_TOKEN=
# CEP de origem dos envios (padrão: fábrica em Cajamar/SP, 07791-842)
FRENET_SELLER_CEP=07791842

# Painel /admin: senha de acesso e segredo para assinar o cookie de sessão (32+ caracteres aleatórios)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# URL pública (Open Graph, canonical)
NEXT_PUBLIC_SITE_URL=https://expressaouniformes.com.br
